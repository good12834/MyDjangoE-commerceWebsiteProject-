# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# ---- Database: sqlite (default) or mysql ----
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=shophub
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ---- Cache / Celery (leave unset to use built-in fallbacks) ----
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# ---- Email (console by default) ----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=ShopHub <no-reply@shophub.dev>

# ---- Payments: Stripe (required) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (set after running `stripe listen`)

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Business rules ----
LOW_STOCK_THRESHOLD=5
FREE_SHIPPING_THRESHOLD=150
SHIPPING_FLAT_RATE=9.99
TAX_RATE=0.08
